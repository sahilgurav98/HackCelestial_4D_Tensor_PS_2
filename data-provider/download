# =========================================================
# TravelGuard AI - Root .gitignore
# =========================================================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# -------------------------
# Node.js
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# -------------------------
# Build outputs
# -------------------------
dist/
build/
out/
coverage/
.next/
.nuxt/
.vite/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

.venv/
venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# ML / Data
# -------------------------
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.onnx

# Large datasets
data/raw/
data/processed/
datasets/
*.csv
*.parquet
*.feather

# Keep small sample data if needed
!data/sample/
!data/sample/*.json

# -------------------------
# Logs
# -------------------------
*.log
logs/

# -------------------------
# MongoDB
# -------------------------
mongodb/
*.bson

# -------------------------
# Neo4j
# -------------------------
neo4j/data/
neo4j/logs/
neo4j/plugins/
neo4j/import/
neo4j/conf/

# -------------------------
# IDEs
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

.idea/
*.iml

# -------------------------
# OS files
# -------------------------
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.swp
*.swo
*.bak
*.backup

# -------------------------
# Test / cache
# -------------------------
.cache/
.temp/
tmp/

# -------------------------
# Frontend
# -------------------------
frontend/.vite/
frontend/dist/
frontend/node_modules/

# -------------------------
# Backend
# -------------------------
backend/node_modules/
backend/dist/

# -------------------------
# Data Provider
# -------------------------
data-provider/node_modules/
data-provider/dist/

# -------------------------
# Python services
# -------------------------
backend/**/__pycache__/
ml-service/**/__pycache__/
ml-service/.venv/

# -------------------------
# Local databases / runtime
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Generated files
# -------------------------
generated/
artifacts/
